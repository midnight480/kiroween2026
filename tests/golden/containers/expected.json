{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "FARGATE-APP",
  "Metadata": {
    "Author": "COBOLFORM"
  },
  "Resources": {
    "AppVpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.1.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true
      }
    },
    "AppIgw": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {}
    },
    "AppAttach": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "AppVpc"
        },
        "InternetGatewayId": {
          "Ref": "AppIgw"
        }
      }
    },
    "AppRt": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "AppVpc"
        }
      }
    },
    "AppRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "AppAttach",
      "Properties": {
        "RouteTableId": {
          "Ref": "AppRt"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "AppIgw"
        }
      }
    },
    "AppSubnetA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "AppVpc"
        },
        "CidrBlock": "10.1.1.0/24",
        "AvailabilityZone": "ap-northeast-1a",
        "MapPublicIpOnLaunch": true
      }
    },
    "AppAssocA": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "AppSubnetA"
        },
        "RouteTableId": {
          "Ref": "AppRt"
        }
      }
    },
    "AppSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Web from anywhere",
        "VpcId": {
          "Ref": "AppVpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "AppExecRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
        ]
      }
    },
    "AppLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/cobolform/app",
        "RetentionInDays": 7
      }
    },
    "AppCluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterName": "cobolform"
      }
    },
    "AppTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "cobolform-app",
        "Cpu": "256",
        "Memory": "512",
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "AppExecRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "web",
            "Image": "public.ecr.aws/nginx/nginx:stable",
            "PortMappings": [
              {
                "ContainerPort": 80
              }
            ],
            "LogConfiguration": {
              "Options": {
                "awslogs-group": {
                  "Ref": "AppLogs"
                },
                "awslogs-region": "ap-northeast-1",
                "awslogs-stream-prefix": "ecs"
              },
              "LogDriver": "awslogs"
            },
            "Environment": [
              {
                "Name": "GREETING",
                "Value": "hello from COBOL"
              }
            ],
            "Essential": true
          }
        ],
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ]
      }
    },
    "AppService": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": {
          "Ref": "AppCluster"
        },
        "TaskDefinition": {
          "Ref": "AppTask"
        },
        "DesiredCount": 1,
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": [
              {
                "Ref": "AppSubnetA"
              }
            ],
            "SecurityGroups": [
              {
                "Ref": "AppSecurityGroup"
              }
            ],
            "AssignPublicIp": "ENABLED"
          }
        },
        "LaunchType": "FARGATE"
      }
    }
  }
}
